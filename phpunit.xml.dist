<?xml version="1.0" encoding="UTF-8"?>

<phpunit 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
    bootstrap="Tests/bootstrap.php"
    cacheDirectory="runtime/cache/phpunit"
    executionOrder="depends,defects"
    requireCoverageMetadata="false"
    beStrictAboutChangesToGlobalState="true"
    beStrictAboutCoverageMetadata="true"
    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    failOnDeprecation="true"
    failOnEmptyTestSuite="true"
    failOnIncomplete="true"
    failOnNotice="true"
    failOnPhpunitDeprecation="true"
    failOnPhpunitWarning="true"
    failOnRisky="true"
    failOnSkipped="true"
    failOnWarning="true"
    colors="true"
    displayDetailsOnPhpunitDeprecations="true">
    <php>
        <ini name="error_reporting" value="-1"/>
    </php>
   <testsuites>
        <testsuite name="PHPUnit">
            <directory>./Tests/PHPUnit</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>./Tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>./src</directory>
        </include>
        <exclude>
            <directory>./src/Invoice/Asset</directory>
            <!-- Tested exclusively via Testo (Tests/Testo/Bookkeeping),
                 never PHPUnit. Without this, PHPUnit's own coverage.xml
                 still lists every line here as 0% (it never executes
                 these Testo-attributed tests), and SonarCloud importing
                 both coverage.xml and coverage-testo.xml for the same
                 files produced a diluted, non-100% new_coverage number
                 for a module Testo alone already covers completely,
                 confirmed live against the SonarCloud API on PR #1338. -->
            <directory>./src/Bookkeeping</directory>
        </exclude>
    </source>
</phpunit>