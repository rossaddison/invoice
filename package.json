{
  "name": "yii3-i",
  "version": "1.0.0",
  "description": "Yii3 Invoice",
  "type": "module",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bs5-lightbox": "^1.8.5",
    "clipboard": "^2.0.11",
    "flag-icons": "^7.5.0",
    "govuk-frontend": "^6.5.0",
    "hono": ">=4.13.5",
    "htmx.org": "^2.0.10",
    "libphonenumber-js": "^1.13.12"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "js-yaml": "5.4.1",    
    "jsdom": "^30.0.1",
    "minimatch": ">=10.2.6",
    "npm-check-updates": "^23.1.0",
    "otplib": "^13.5.0",
    "picomatch": "^4.0.7",
    "prettier": "^4.0.0-alpha.13",
    "rollup": ">=4.63.1",
    "sass": "^1.104.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitepress": "^2.0.0-alpha.18",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npm run build:css && npm run build:typescript",
    "build:css": "sass src/Invoice/Asset/invoice/scss/style.scss src/Invoice/Asset/invoice/css/style.css --style=expanded --no-source-map",
    "build:css:prod": "sass src/Invoice/Asset/invoice/scss/style.scss src/Invoice/Asset/invoice/css/style.css --style=compressed --no-source-map",
    "build:typescript": "npm run build:typescript:prod",
    "build:typescript:dev": "esbuild src/typescript/index.ts --bundle --outfile=src/Invoice/Asset/rebuild/js/invoice-typescript-iife.js --target=es2024 --format=iife --global-name=InvoiceApp --sourcemap --supported:const=true",
    "build:typescript:auth": "esbuild src/Auth/Asset/keypad-copy-to-clipboard.ts --bundle --platform=browser --outfile=src/Auth/Asset/rebuild/js/keypad-copy-to-clipboard-iife.js --target=es2024 --format=iife --minify --supported:const-and-let=true",
    "build:typescript:sw": "esbuild src/typescript/sw.ts --bundle --outfile=public/sw.js --target=es2024 --format=iife --minify --supported:const-and-let=true",
    "build:typescript:homecare-shell": "esbuild src/typescript/homecare-offline-shell.ts --bundle --outfile=public/homecare-offline-shell.js --target=es2024 --format=esm --minify --supported:const-and-let=true",
    "build:typescript:webshop": "esbuild src/Webshop/Cart/Asset/cart.ts --bundle --platform=browser --outfile=src/Webshop/Cart/Asset/rebuild/js/cart-iife.js --target=es2024 --format=iife --minify --supported:const-and-let=true && esbuild src/Webshop/Catalog/Asset/price-range.ts --bundle --platform=browser --outfile=src/Webshop/Catalog/Asset/rebuild/js/price-range-iife.js --target=es2024 --format=iife --minify --supported:const-and-let=true && esbuild src/Webshop/Catalog/Asset/product-zoom.ts --bundle --platform=browser --outfile=src/Webshop/Catalog/Asset/rebuild/js/product-zoom-iife.js --target=es2024 --format=iife --minify --supported:const-and-let=true && esbuild src/Webshop/Asset/storefront-tooltip.ts --bundle --platform=browser --outfile=src/Webshop/Asset/rebuild/js/storefront-tooltip-iife.js --target=es2024 --format=iife --minify --supported:const-and-let=true",
    "build:typescript:prod": "esbuild src/typescript/index.ts --bundle --outfile=src/Invoice/Asset/rebuild/js/invoice-typescript-iife.js --target=es2024 --format=iife --global-name=InvoiceApp --minify --supported:const-and-let=true && esbuild src/typescript/index.ts --bundle --outfile=src/Invoice/Asset/rebuild/js/invoice-typescript-iife.min.js --target=es2024 --format=iife --global-name=InvoiceApp --minify --supported:const-and-let=true && npm run build:typescript:sw && npm run build:typescript:homecare-shell",
    "build:typescript:watch": "npm run build:typescript:dev -- --watch",
    "build:playwright": "esbuild playwright/render-invoice.ts --bundle --platform=node --format=esm --outfile=playwright/render-invoice.js --external:playwright --target=node22",
    "prepare": "git config core.hooksPath .githooks",
    "build:dev": "npm run build:typescript:dev",
    "build:prod": "npm run build:typescript:prod",
    "build:watch": "npm run build:typescript:watch",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint src/typescript/**/*.ts",
    "lint:fix": "eslint src/typescript/**/*.ts --fix",
    "format": "prettier --write src/typescript/**/*.ts",
    "format:check": "prettier --check src/typescript/**/*.ts",
    "security:quick": "snyk test --severity-threshold=high",
    "security:full": "snyk test && snyk code test",
    "security:deps": "snyk test",
    "dev": "npm run build:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "upgrade:check": "npx ncu --target minor",
    "upgrade:safe": "npx ncu --target patch -u && npm install",
    "upgrade:minor": "npx ncu --target minor -u && npm install",
    "upgrade:major": "npx ncu --target greatest -i",
    "generate:docs": "typedoc src/typescript/ --out docs/api",
    "clean": "rm -rf src/Invoice/Asset/rebuild/js/invoice-typescript-iife.js*",
    "es2024:verify": "node -e \"console.log('ES2024 features available:', Object.hasOwn({}, 'test'), Array.prototype.toSorted ? 'toSorted' : 'missing', Object.groupBy ? 'groupBy' : 'missing', Promise.withResolvers ? 'withResolvers' : 'missing')\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "overrides": {
    "webpack-dev-server": "^6.0.0",
    "uuid": ">=11.1.1",
    "esbuild": "^0.28.2",
    "vite": ">7.3.4",
    "body-parser": ">=2.3.0",
    "fast-uri": ">=4.1.2",
    "postcss": ">=8.5.18",
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": ">=2.0.11"
    }
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "yii3",
    "invoice",
    "typescript",
    "es2024",
    "bootstrap5",
    "govuk-frontend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rossaddison/invoice.git"
  },
  "bugs": {
    "url": "https://github.com/rossaddison/invoice/issues"
  },
  "homepage": "https://github.com/rossaddison/invoice#readme",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
