# The session related environment variables $_ENV listed here are used in the autoload.php function
# which loads them into non-session related $_SERVER variables. Consistent boolean values entered here are 
# ensured in the autoload.php function's filter_var function.
# see: https://www.php.net/manual/en/function.filter-var.php#121263
# see: Testing of boolean values: At command line e.g. C:\wamp64\www\invoice>php php-space-filter-var-test.php

# Used in: config\common\params.php
# see: https://github.com/copilot/share/022253bc-0004-88a2-b010-084860c36925
# Docker Desktop: Insert IPv4 address in config\common\params.php switch case 'docker':
# docker wamp lamp local alpine
APP_ENV=local

# Used in: config\common\params.php. If left blank defaults to 'yii3_i'
DB_NAME=

# Used in: config\common\params.php. If left blank defaults to 'root'
DB_USERNAME=

# Used in: config\common\params.php. If left blank defaults to null
DB_PASSWORD=

# Used in: config\common\params.php.
# docker: If left blank defaults to arbitrary ip address '192.168.0.24'
# wamp/lamp/local/alpine: If left blank defaults to 'localhost'
DB_HOST_IP_ADDRESS=

# Used, inter alia, in: autoload.php (normalizes it, mirrors into
# $_SERVER), src\Auth\Trait\Callback.php + src\Auth\Trait\Oauth2.php (via
# SettingRepository::getEnv() — gates the HMRC sandbox test-user flow to
# dev only), and config\web\di\mailer.php (dev-only: emails are written to
# runtime\mail\*.eml instead of sent). Also selects which
# config\environments\{dev,prod,test}\params.php gets merged in — prod is
# the only one that turns on FastRoute's route-dispatch cache, which has
# NO auto-invalidation and needs an explicit `php yii cache/clear` after
# any route change on deploy. Full explanation:
# docs\YII_ENV_ROUTE_CACHE_AND_DEPLOY_JULY_2026.md
# String Value: e.g prod or dev
YII_ENV=dev

# Used, inter alia, in: src\viewInjection\LayoutViewInjection with $debugMode
# Boolean Values that are acceptable and will be passed to the filter_var in autoload.php function which ensures a boolean is output are namely: 
# ...that equate to true:    'true', true, TRUE, 'TRUE', "TRUE", '1', "1", 1
# ...that equate to false:   'false', false, FALSE, 'FALSE', "FALSE", '0', "0", 0, {nothing i.e no value}, "lots of meaningless data"
# ...any number of spaces can be put after the equal sign and before the boolean equivalent value
# ...Note: The final value can be observed under the application's debug mode menu ... FAQ'S ... Php Details ? Variables for testing purposes
# ...Note: Any values not in the above lists e.g. asdfasdf will be equated to false
YII_DEBUG=true

# Used in: config\common\params.php to install the tables for the database on initial setup
# Used in: src\ViewInjection\LayoutViewInjection to inform if setting is still true which will impact performance
# Boolean Value
BUILD_DATABASE=

# Used in: config\common\params.php Insert a string here without quotes
SENTRY_DSN=

# Used in config\common\bootstrap and config\web\di\application
BASE_URL=

# Used by playwright/render-invoice.ts (via `php yii invoice/render-pdf`) to
# log in before rendering a PDF. Point these at a real, working local
# account — never commit real values here.
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
# Only needed once that account has 2FA enabled — the script prints this
# secret to the console on its first run (which walks through 2FA setup);
# save it here so subsequent runs skip straight to verification. It's a
# base32 string (A-Z, 2-7), e.g. in shape (not a working value —
# always use the one YOUR account's setup run actually printed):
# PLAYWRIGHT_TEST_TOTP_SECRET=JBSWY3DPEHPK3PXP
PLAYWRIGHT_TEST_TOTP_SECRET=
# Absolute path to node.exe — only needed when the PDF-render button (not
# the `php yii invoice/render-pdf` console command) is used, and only if
# Apache's service account doesn't have Node on its own PATH (it doesn't
# inherit the interactive user's PATH, e.g. nvm-for-windows installs).
# Leave empty to use plain `node` resolved from PATH.
NODE_BINARY=

# Used in: config\common\params.php (yiisoft/cookies secretKey), consumed by
# config\web\di\auth.php to sign/encrypt cookies, including "remember me"
# cookie-login. Must be unique per deployment — do not reuse this value or
# commit a real one. Generate with: php -r "echo bin2hex(random_bytes(32));"
COOKIE_SECRET_KEY=

# Used in: autoload.php, drives config\web\params.php session cookie_secure.
# Leave false/blank until TLS is confirmed live end-to-end in this
# deployment — yiisoft/session throws a hard error on every request if this
# is true but the request scheme isn't https. Set to true only after
# uncommenting the HTTPS-redirect rule in public/.htaccess and confirming it
# works. Boolean Value (see YII_DEBUG above for accepted true/false forms).
SESSION_COOKIE_SECURE=false

# Used in: config\common\params.php Insert a string here without quotes.
SENDER_EMAIL=
# Used in: config\common\params.php Insert a string here without quotes.
ADMIN_EMAIL=
# Used in: config\common\params.php Insert a string here without quotes.
SYMFONY_MAILER_USERNAME=
# Used in: config\common\params.php Insert a string here without quotes.
SYMFONY_MAILER_PASSWORD=
# Used in: config\common\params.php Insert a string here without quotes.
# Defaults to smtp.gmail.com
SYMFONY_MAILER_HOST=
# smtps 465 smtp 587
# Used in: config\common\params.php Insert an integer here without quotes.
# For additional security, will be cast to an int in params.php if mistakenly
# entered as a string here. Defaults to 465 for smtps TLS.
SYMFONY_MAILER_PORT=

# Used in: config\common\params.php to build the oauth2 Clients array of Identity Providers (idP's) e.g Google, Facebook, Github
# Note: The config\web\di\auth.php does NOT use the yiisoft/yii-auth-client Collection function to build the 'Clients' array above but uses the SettingRepository functions for this purpose.

GOOGLE_API_CLIENT_ID=test_google_client_id_from_dot_env
GOOGLE_API_CLIENT_SECRET=test_google_client_secret_from_dot_env
GOOGLE_API_CLIENT_RETURN_URL=test_google_client_secret_from_dot_env

FACEBOOK_API_CLIENT_ID=test_facebook_client_id_from_dot_env
FACEBOOK_API_CLIENT_SECRET=test_facebook_client_secret_from_dot_env
FACEBOOK_API_CLIENT_RETURN_URL=test_facebook_client_return_url_from_dot_env

GITHUB_API_CLIENT_ID=test_github_client_id_from_dot_env
GITHUB_API_CLIENT_SECRET=test_github_client_secret_from_dot_env
GITHUB_API_CLIENT_RETURN_URL=test_github_client_return_url_from_dot_env

LINKEDIN_API_CLIENT_ID=test_linkedin_client_id_from_dot_env
LINKEDIN_API_CLIENT_SECRET=test_linkedin_client_secret_from_dot_env
LINKEDIN_API_CLIENT_RETURN_URL=test_linkedin_client_return_url_from_dot_env

MICROSOFTONLINE_API_CLIENT_ID=test_microsoftonline_client_id_from_dot_env
MICROSOFTONLINE_API_CLIENT_SECRET=test_microsoftonline_client_secret_from_dot_env
MICROSOFTONLINE_API_CLIENT_RETURN_URL=test_microsoftonline_client_return_url_from_dot_env
MICROSOFTONLINE_API_CLIENT_TENANT=test_microsoftonline_client_tenant_from_dot_env

OPENBANKING_API_CLIENT_ID=test_openbanking_client_id_from_dot_env
OPENBANKING_API_CLIENT_SECRET=test_openbanking_client_secret_from_dot_env
OPENBANKING_API_CLIENT_RETURN_URL=test_openbanking_client_return_url_from_dot_env

VKONTAKTE_API_CLIENT_ID=test_vkontakte_client_id_from_dot_env
VKONTAKTE_API_CLIENT_SECRET=test_vkontakte_client_secret_from_dot_env
VKONTAKTE_API_CLIENT_RETURN_URL=test_vkontakte_client_return_url_from_dot_env

X_API_CLIENT_ID=test_x_client_id_from_dot_env
X_API_CLIENT_SECRET=test_x_client_secret_from_dot_env
X_API_CLIENT_RETURN_URL=test_x_client_return_url_from_dot_env

OIDC_API_CLIENT_ID=test_oidc_client_id_from_dot_env
OIDC_API_CLIENT_SECRET=test_oidc_client_secret_from_dot_env
OIDC_API_CLIENT_RETURN_URL=test_oidc_client_return_url_from_dot_env

GOVUK_API_CLIENT_ID=test_govuk_client_id_from_dot_env
GOVUK_API_CLIENT_SECRET=test_govuk_client_secret_from_dot_env
GOVUK_API_CLIENT_RETURN_URL=test_govuk_client_return_url_from_dot_env
GOVUK_PHPSECLIB3_PUBLIC_KEY_LOADER_RAW=raw

DEVELOPER_GOV_SANDBOX_HMRC_API_CLIENT_ID=test_developer_gov_sandbox_hmrc_client_id_from_dot_env
DEVELOPER_GOV_SANDBOX_HMRC_API_CLIENT_SECRET=test_developer_gov_sandbox_hmrc_client_secret_from_dot_env
DEVELOPER_GOV_SANDBOX_HMRC_API_CLIENT_RETURN_URL=test_developer_gov_sandbox_hmrc_client_return_url_from_dot_env

# Prometheus Monitoring Configuration
# Used in: config\common\prometheus.php for metrics collection and storage

# Enable/disable Prometheus metrics collection
# Boolean Value: true = enabled, false = disabled
PROMETHEUS_ENABLED=true

# Storage backend for Prometheus metrics
# String Value: 'memory' (development), 'redis' (production), or 'apcu' (shared hosting)
PROMETHEUS_STORAGE_TYPE=memory

# Redis Configuration (used when PROMETHEUS_STORAGE_TYPE=redis)
# String Value: Redis server hostname or IP address
REDIS_HOST=127.0.0.1

# Integer Value: Redis server port number
REDIS_PORT=6379

# Float Value: Connection timeout in seconds
REDIS_TIMEOUT=0.1

# Integer Value: Read timeout in seconds  
REDIS_READ_TIMEOUT=10

# Boolean Value: Use persistent Redis connections
REDIS_PERSISTENT=false

# -----------------------------------------------------------------------
# Peppol / Oxalis network transport
# Used in: config/common/di/peppol.php
# See: src/Invoice/Peppol/README.md for setup steps
# -----------------------------------------------------------------------

# Base URL of the Oxalis AS4 gateway REST API (no trailing slash).
# Phase A mock: http://localhost:8181
# Phase B real: http://localhost:8080  (or wherever Oxalis listens)
OXALIS_BASE_URL=http://localhost:8181

# Your Peppol participant ID in iso6523-actorid-upis format, e.g. 0088:1234567890123
# Leave blank to let Oxalis derive the sender ID from its keystore certificate.
PEPPOL_SENDER_ID=

# SML DNS zone.
# Production : edelivery.tech.ec.europa.eu
# Acceptance : acc.edelivery.tech.ec.europa.eu
PEPPOL_SML_ZONE=acc.edelivery.tech.ec.europa.eu

# Optional: bypass SML/SMP DNS and point directly at an SMP host.
# Useful in development. Leave blank to use live DNS.
PEPPOL_SMP_BASE_URL=

# -----------------------------------------------------------------------
# AS4 bilateral / direct transport (no Peppol SMP/SML)
# Used in: config/common/di/as4.php
# See: docs/PEPPOL_PKI_CERTIFICATE_REQUEST.md for cert generation steps
# -----------------------------------------------------------------------

# This node's signing private key (PEM file path, owner-read only: chmod 400)
# Generate: openssl genrsa -out /etc/as4/signing-key.pem 4096
AS4_SIGNING_KEY_PATH=/etc/as4/signing-key.pem

# This node's signing certificate (PEM file path)
# Generate: openssl req -new -x509 -key /etc/as4/signing-key.pem \
#             -out /etc/as4/signing-cert.pem -days 365 \
#             -subj "/C=GB/O=Yii3-i/CN=bilateral-node"
AS4_SIGNING_CERT_PATH=/etc/as4/signing-cert.pem

# Peer node's signing certificate — exchange with the other node
# (copy your signing-cert.pem to the peer; they copy theirs to you)
AS4_PEER_CERT_PATH=/etc/as4/peer-cert.pem

# AS4 receive endpoint of the peer node
# localhost → yii3i.online : https://yii3i.online/as4/receive
# yii3i.online → localhost  : https://<ngrok-id>.ngrok-free.app/as4/receive
AS4_PEER_ENDPOINT=https://yii3i.online/as4/receive

# Peer node's party ID (used in ebMS3 To/PartyId element)
# Bilateral convention: bilateral:<hostname>
# Peppol convention   : 0088:1234567890123
AS4_PEER_PARTY_ID=bilateral:yii3i.online

# This node's party ID (used in ebMS3 From/PartyId element)
AS4_SENDER_PARTY_ID=bilateral:localhost

# Transport profile string embedded in ebMS3 Agreement/Service elements
# Any string works for bilateral testing; must match both nodes
AS4_PEER_TRANSPORT_PROFILE=bilateral-as4-test

# Retry policy for failed outbound messages
# 'fixed'       → fixed interval (default, simpler)
# 'exponential' → exponential back-off (production recommended)
AS4_RETRY_POLICY=fixed
