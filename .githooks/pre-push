#!/bin/sh
# Last line of defence before data leaves the machine: refuse a push when any commit in it adds a file
# the sensitive-data guard does not allow (customer documents, env files, databases, archives, big
# files), even if the commit was made with hooks switched off. See .githooks/sensitive-guard.sh.

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    sh "$(dirname "$0")/sensitive-guard.sh" range "$remote_sha" "$local_sha" || status=1
done

if [ $status -ne 0 ]; then
    echo "[pre-push] Push aborted: a commit in it carries data that must not be pushed." >&2
    echo "[pre-push] Remove the file from the commit (git rm --cached, then amend or reset); do not bypass this hook." >&2
    exit 1
fi
exit 0
